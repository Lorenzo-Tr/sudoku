{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sudoku",
  "version": "0.1.0",
  "identifier": "com.lorenzotr.sudoku",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sudoku",
        "width": 1180,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
